CheckoutSvc --> [CheckoutSession] : creates

OrderSvc --> CartSvc : loads cart
OrderSvc --> PaymentSvc : initiates payment
OrderSvc --> StockModule : locks stock
OrderSvc --> OrderModel : manages
OrderSvc --> OrderItemModel : creates
OrderSvc --> [OrderShippingAddress] : creates
OrderSvc --> [OrderBillingAddress] : creates
OrderSvc --> [OrderStatusHistory] : tracks

PaymentSvc --> PaymentAdapter : uses interface
PaymentSvc --> PaymentModel : manages
PaymentSvc --> [PaymentRefund] : creates

AddressSvc --> UserModule : loads addresses

' ================================
' SERVICE → MODEL DEPENDENCIES
' ================================
CartSvc ..> [CartStatus] : uses enum
OrderSvc ..> [OrderStatus] : uses enum
OrderSvc ..> [PaymentStatus] : uses enum
PaymentSvc ..> [PaymentMethod] : uses enum

' ================================
' MODEL → DATABASE DEPENDENCIES
' ================================
