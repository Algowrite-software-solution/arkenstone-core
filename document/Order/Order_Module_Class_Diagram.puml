' ==================== ENUM PACKAGE ====================
package "Enums" <<Rectangle>> #FFFEF0 {
    
    enum OrderStatus <<Enum>> {
        PENDING_PAYMENT
        CONFIRMED
        PROCESSING
        SHIPPED
        DELIVERED
        COMPLETED
        CANCELLED
        RETURNED
        --
        +label(): string
        +canTransitionTo(OrderStatus): bool
        +isCancellable(): bool
    }
    
    enum PaymentStatus <<Enum>> {
        PENDING
        COD_PENDING
        AWAITING_PAYMENT
        PAYMENT_INITIATED
        PAID
        FAILED
        REFUNDING
        REFUNDED
        CANCELLED
        --
        +label(): string
        +isSuccessful(): bool
        +isFailed(): bool
        +isPending(): bool
    }
    
    enum PaymentMethod <<Enum>> {
        CARD
        COD
        BANK_TRANSFER
        --
        +label(): string
        +requiresGateway(): bool
        +requiresManualConfirmation(): bool
        +isPayOnDelivery(): bool
    }
    
    enum CartStatus <<Enum>> {
        ACTIVE
        COMPLETED
        MIGRATED
        EXPIRED
        --
        +label(): string
        +isActive(): bool
        +isCompleted(): bool
    }
    
    enum DiscountType <<Enum>> {
        PERCENTAGE
        FIXED
        NONE
        --
        +label(): string
        +calculate(float, float): float
    }
}

