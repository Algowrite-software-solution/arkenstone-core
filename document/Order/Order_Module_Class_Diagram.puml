' ==================== CONTRACT/INTERFACE PACKAGE ====================
package "Contracts" <<Rectangle>> #FFF8E1 {
    
    interface CartServiceInterface <<Contract>> {
        +getCart(int|null, string|null): Cart|null
        +addToCart(array): CartItem
        +updateCartItem(int, int): CartItem
        +removeFromCart(int): bool
        +clearCart(int|null, string|null): bool
        +validateCart(Cart): array
        +migrateGuestCart(string, int): Cart
        +calculateTotals(Cart): array
    }
    
    interface CheckoutServiceInterface <<Contract>> {
        +initiateCheckout(Cart): CheckoutSession
        +validateCheckout(CheckoutSession): array
        +calculateShipping(array, Cart): array
        +calculateTotals(Cart, array): array
        +createCheckoutSession(Cart, array): CheckoutSession
    }
    
    interface OrderServiceInterface <<Contract>> {
        +createOrder(CheckoutSession): Order
        +getOrder(string): Order|null
        +getOrderHistory(int, array): Collection
        +updateOrderStatus(int, OrderStatus, string): Order
        +cancelOrder(int, int, string, string): Order
        +createOrderFromCart(Cart, array): Order
    }
    
    interface PaymentServiceInterface <<Contract>> {
        +initiatePayment(Order): Payment
        +processWebhook(string, Request): WebhookResponse
        +refundPayment(int, decimal, string): PaymentRefund
        +getPaymentStatus(int): PaymentStatus
        +handlePaymentSuccess(Payment): void
        +handlePaymentFailure(Payment, string): void
    }
    
    interface PaymentAdapterInterface <<Contract>> {
        +createPayment(array): PaymentResponse
        +capturePayment(string): PaymentResponse
        +refundPayment(string, float): PaymentResponse
        +getPaymentStatus(string): PaymentResponse
        +handleWebhook(Request): WebhookResponse
        +verifyWebhookSignature(Request): bool
    }
    
    class PaymentResponse <<ValueObject>> {
        +success: bool
        +payment_id: string|null
        +status: string
        +redirect_url: string|null
        +message: string|null
        +raw_response: array
        
        +__construct(array)
        +isSuccessful(): bool
        +requiresRedirect(): bool
    }
    
    class WebhookResponse <<ValueObject>> {
        +event_type: string
        +payment_id: string
        +status: string
        +amount: float
        +metadata: array
        
        +__construct(array)
        +isPaymentSuccess(): bool
        +isPaymentFailed(): bool
    }
    
    class CheckoutSession <<ValueObject>> {
        +cart_id: int
        +user_id: int|null
        +shipping_address: array
        +billing_address: array
        +shipping_method: array
        +payment_method: PaymentMethod
        +totals: array
        +token: string
        +expires_at: datetime
        
        +__construct(array)
        +isExpired(): bool
        +toArray(): array
    }
}

