@startuml Order Module - Complete Use Case Diagram (Clean Layout)
!theme plain
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam nodesep 80
skinparam ranksep 100

title Order Module - Complete Use Case Diagram\n(Arkenstone Core E-Commerce Package)

' ===== LEFT SIDE: USER ACTORS =====
left to right direction

actor "Guest User" as Guest #LightCoral
actor "Logged User" as User #LightGreen  
actor "Customer" as Customer #LightBlue

' ===== CENTER: MAIN WORKFLOWS =====
package "Order Module Core Workflows" {
  
  rectangle "Cart" #E8F5E9 {
    (Add to Cart) as AddCart
    (Update Quantity) as UpdateCart
    (View Cart) as ViewCart
    (Apply Coupon) as ApplyCoupon
  }
  
  rectangle "Checkout" #E3F2FD {
    (Initiate Checkout) as InitCheckout
    (Add Address) as Address
    (Select Shipping) as Shipping
    (Select Payment) as Payment
    (Review Order) as Review
  }
  
  rectangle "Order" #FFF3E0 {
    (Place Order) as PlaceOrder
    (View Orders) as ViewOrders
    (Track Order) as TrackOrder
    (Cancel Order) as CancelOrder
  }
  
  rectangle "Payment" #FCE4EC {
    (Pay with Card) as CardPay
    (Pay with COD) as CODPay
    (Pay via Bank) as BankPay
    (Retry Payment) as RetryPay
  }
}

' ===== RIGHT SIDE: ADMIN & SYSTEM ACTORS =====
actor "Admin" as Admin #Orange
actor "Payment\nGateway" as Gateway #Yellow
actor "System" as System #Pink

' ===== BOTTOM: SUPPORTING SERVICES =====
package "Supporting Services" {
  
  rectangle "Address Management" #FFF9C4 {
    (Saved Addresses) as SavedAddr
    (Edit Address) as EditAddr
  }
  
  rectangle "Stock Management" #E0F2F1 {
    (Check Stock) as CheckStock
    (Reserve Stock) as ReserveStock
    (Deduct Stock) as DeductStock
  }
  
  rectangle "Admin Operations" #FFE0B2 {
    (Manage Orders) as ManageOrders
    (Update Status) as UpdateStatus
    (Process Refund) as Refund
    (Manual Confirm) as ManualConfirm
  }
  
  rectangle "Automated Tasks" #FFCDD2 {
    (Cleanup Carts) as Cleanup
    (Cancel Expired) as CancelExpired
    (Auto-Complete) as AutoComplete
  }
}

' ===== GUEST USER CONNECTIONS =====
Guest -down-> AddCart
Guest -down-> ViewCart
Guest -down-> InitCheckout

' ===== LOGGED USER CONNECTIONS =====
User -down-> AddCart
User -down-> ViewCart
User -down-> ApplyCoupon
User -down-> InitCheckout
User -down-> ViewOrders
User -down-> TrackOrder
User -down-> CancelOrder
User -down-> SavedAddr

' ===== CUSTOMER CONNECTIONS (CHECKOUT) =====
Customer -down-> Address
Customer -down-> Shipping
Customer -down-> Payment
Customer -down-> Review

' ===== ADMIN CONNECTIONS =====
Admin -down-> ManageOrders
Admin -down-> UpdateStatus
Admin -down-> Refund
Admin -down-> ManualConfirm

' ===== GATEWAY CONNECTIONS =====
Gateway -down-> CardPay
Gateway -down-> Refund

' ===== SYSTEM CONNECTIONS =====
System -down-> Cleanup
System -down-> CancelExpired
System -down-> AutoComplete

' ===== WORKFLOW SEQUENCES (LEFT TO RIGHT) =====
AddCart -right-> InitCheckout
InitCheckout -right-> PlaceOrder
PlaceOrder -right-> CardPay
PlaceOrder -right-> CODPay
PlaceOrder -right-> BankPay

' ===== INCLUDE RELATIONSHIPS (MINIMAL) =====
AddCart .down.> CheckStock : <<include>>
AddCart .down.> ReserveStock : <<include>>
PlaceOrder .down.> DeductStock : <<include>>
InitCheckout .down.> Address : <<include>>
Address .down.> EditAddr : <<include>>

' ===== NOTES (POSITIONED) =====
note right of Guest
  **Guest:**
  Session cart (7 days)
  Email required
end note

note right of User
  **Logged:**
  Persistent cart
  Saved addresses
  Order history
end note

note right of Admin
  **Admin:**
  Full access
  Manual operations
  Refund processing
end note

note bottom of System
  **Automated:**
  Hourly/Daily jobs
  Cart cleanup
  Status updates
end note

@enduml
