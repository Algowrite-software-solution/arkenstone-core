{
  "name": "arkenstone/core",
  "description": "Laravel package: Arkenstone",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Janith Nirmal",
      "email": "rmjanithnirmal@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "orchestra/testbench": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Arkenstone\\Core\\": "src/",
      "Arkenstone\\Core\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Arkenstone\\Core\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Arkenstone\\Core\\CoreServiceProvider"
      ],
      "aliases": {
        "Feature1": "Arkenstone\\Core\\Facades\\Feature1"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
